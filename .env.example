# Valores para desenvolvimento local. Em produção: APP_ENV=production, APP_DEBUG=false
# (sem isso erros exibem SQL e stack trace), APP_URL com https e um APP_KEY próprio.
# Veja docs/architecture.md, seção "Produção".
APP_NAME=InsureFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=insureflow
DB_USERNAME=insureflow
# Senha apenas do banco local em Docker; nunca reutilize fora do desenvolvimento.
DB_PASSWORD=change-me-local-only

# Em produção (HTTPS): SESSION_SECURE_COOKIE=true e SESSION_ENCRYPT=true.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@insureflow.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Docker Compose (portas expostas no host e UID/GID do usuário dos containers PHP)
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=5433
HOST_UID=1000
HOST_GID=1000
# Necessário no Windows/macOS: o bind mount não propaga eventos de arquivo para o container
VITE_USE_POLLING=true

# Senha dos usuários de demonstração criados por "php artisan db:seed" (somente desenvolvimento).
# Os seeders se recusam a rodar com APP_ENV=production.
SEED_DEFAULT_PASSWORD=password
